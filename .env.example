TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
ADMIN_EMAIL=you@example.com
# Escape every $ as \$ — Vite's dotenv-expand otherwise treats $2b/$10/... as variable refs
ADMIN_PASSWORD_HASH=bcrypt-hash-generated-by-scripts/hash-password.js-with-escaped-dollar-signs
SESSION_SECRET=long-random-string
